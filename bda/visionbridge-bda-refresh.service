[Unit]
Description=VisionBridge HDFS and Spark refresh worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/Desktop/BDA/project
Environment="PATH=/usr/local/hadoop/bin:/usr/local/hadoop/sbin:/usr/local/bin:/usr/bin:/bin"
Environment="JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64"
Environment="HADOOP_HOME=/usr/local/hadoop"
ExecStart=/usr/bin/python3 -m bda.live_pipeline --project /home/admin/Desktop/BDA/project --spool spool
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
